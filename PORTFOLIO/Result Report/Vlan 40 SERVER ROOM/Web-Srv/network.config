
config interface 'loopback'
        option device 'lo'
        option proto 'static'
        list ipaddr '127.0.0.1/8'

config globals 'globals'
        option dhcp_default_duid '000485722c55f8b547cfa24aad7a9385bda4'
        option ula_prefix 'fd74:c8b5:a7a6::/48'

config device
        option name 'br-lan'
        option type 'bridge'
        list ports 'eth0'

config interface 'lan'
        option proto 'static'
        option device 'eth0'
        list ipaddr '192.168.40.10/24'
        option gateway '192.168.40.1'
        list dns '8.8.8.8'
